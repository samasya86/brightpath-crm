# ==============================================================================
# BrightPath CRM — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename it to `.env` in the project root directory.
# 2. In your Supabase Dashboard (https://supabase.com/dashboard), select your project.
# 3. Navigate to: Project Settings > API.
# 4. Copy the "Project URL" and paste it into VITE_SUPABASE_URL.
# 5. Copy the "anon" / "public" API key and paste it into VITE_SUPABASE_ANON_KEY.
# 
# IMPORTANT SECURITY NOTICE:
# - NEVER commit `.env` containing your real credentials to Git.
# - NEVER use the privileged `service_role` key in frontend code.
# ==============================================================================

# Supabase Project URL (Example: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public API Key (Safe for browser/frontend usage)
VITE_SUPABASE_ANON_KEY=your-anon-public-key
